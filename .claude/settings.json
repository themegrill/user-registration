{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git ls-files*)",
      "Bash(git diff --name-only*)",
      "Bash(git diff --name-status*)",
      "Bash(git log --name-only*)",
      "Bash(git log --name-status*)",
      "Bash(php vendor/bin/phpcs*)",
      "Bash(composer phpcs*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm prettier)",
      "Bash(pnpm exec grunt js)",
      "Bash(pnpm exec grunt css)",
      "Bash(node --test .claude/hooks/hooks.test.mjs .claude/skills/ur-check/plan-checks.test.mjs)",
      "Bash(node --test .claude/hooks/hooks.test.mjs)",
      "Bash(node --test .claude/skills/ur-check/plan-checks.test.mjs)",
      "Bash(node .claude/skills/ur-check/plan-checks.mjs*)"
    ],
    "ask": [
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm build*)",
      "Bash(pnpm run build*)",
      "Bash(composer update*)"
    ],
    "deny": [
      "Read(./.themegrill-qa/.env.local)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git diff*.env*)",
      "Bash(git log*.env*)",
      "Bash(git show*.env*)",
      "Bash(php vendor/bin/phpcs*.env*)",
      "Bash(composer phpcs*.env*)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git show*--output*)",
      "Bash(git diff*--no-index*)",
      "Bash(git diff*-p*)",
      "Bash(git diff*--patch*)",
      "Bash(git diff*-u*)",
      "Bash(git log*-p*)",
      "Bash(git log*--patch*)",
      "Bash(git log*-u*)",
      "Bash(git show*-p*)",
      "Bash(git show*--patch*)",
      "Bash(git show*-u*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-files.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/phpcs-changed.mjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
