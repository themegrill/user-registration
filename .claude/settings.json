{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(php vendor/bin/phpcs*)",
      "Bash(composer phpcs*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm prettier)",
      "Bash(pnpm exec grunt js)",
      "Bash(pnpm exec grunt css)",
      "Bash(node --test .claude/hooks/hooks.test.mjs .claude/skills/ur-check/plan-checks.test.mjs)",
      "Bash(node --test .claude/hooks/hooks.test.mjs)",
      "Bash(node --test .claude/skills/ur-check/plan-checks.test.mjs)",
      "Bash(node .claude/skills/ur-check/plan-checks.mjs*)"
    ],
    "ask": [
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm build*)",
      "Bash(pnpm run build*)",
      "Bash(composer update*)"
    ],
    "deny": [
      "Read(./.themegrill-qa/.env.local)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git diff*--output*)",
      "Bash(git log*--output*)",
      "Bash(git show*--output*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/phpcs-changed.mjs"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
